    "version": "0.2.0",
    "configurations": [
        {
            "name": "IronJump (Rust)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--manifest-path",
                    "${workspaceFolder}/Rust/Cargo.toml",
                    "--bin",
                    "ironjump"
                ],
                "filter": {
                    "name": "ironjump",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}/Rust"
        }
    ]
}
